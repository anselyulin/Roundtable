DISCORD_TOKEN=...
DISCORD_GUILD_ID=             # optional, development server only
LLM_PROVIDER=openai          # openai | vertex | fake; use fake for tests and the round demo
OPENAI_API_KEY=...
GOOGLE_CLOUD_PROJECT=        # vertex only: Google Cloud project id or number
GOOGLE_CLOUD_LOCATION=global
VERTEX_API_KEY=              # vertex only: authorization key bound to roundtable-gemini, restricted to Agent Platform API
LLM_MODEL=                   # required for openai or vertex; use a verified available stable text model
DETECTION_MODE=auto          # auto offers Yes/No prompts; command_only reads no ordinary chat
ROUND_DEADLINE_HOURS=24
DETECTION_CONFIDENCE=0.75
DETECTION_COOLDOWN_MIN=15
